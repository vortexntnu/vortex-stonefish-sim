<?xml version="1.0"?>
<scenario>

  <!-- RoboSub 2026 course - extracted from the MathWorks RoboSub UE env,
       laid out per RoboSub 2026 Team Handbook section 3.2.
       Frame: X forward, Y right, Z down; water surface Z=0; floor Z~3.43. -->

  <static name="pool_basin" type="model">
