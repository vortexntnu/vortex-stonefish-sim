<?xml version="1.0"?>
<scenario>

  <!-- RoboSub meshes, INSPECTION layout (grid in front of spawn).
       Frame: X fwd, Y right, Z down; surface Z=0, floor Z~3.43.
       Parked objects centred at Z=1.4.  See data/object_files/robosub/README.md -->

  <static name="pool_basin" type="model">
    <physical>
      <mesh filename="object_files/robosub/Pool_PoolPlane.obj" scale="1.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </physical>
    <visual>
      <mesh filename="object_files/robosub/Pool_PoolPlane.obj" scale="1.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </visual>
    <material name="Concrete"/>
    <look name="White"/>
    <world_transform xyz="0 0 0" rpy="0 0 0"/>
  </static>

  <static name="gate" type="model">
    <physical>
      <mesh filename="object_files/robosub/gate.obj" scale="1.0"/>
      <origin xyz="1.5240 -0.0000 0.2852" rpy="0.0 0.0 0.0"/>
